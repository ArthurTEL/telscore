{
  "cleanUrls": true,
  "functions": {
    "api/banco.js": {
      "maxDuration": 60
    },
    "api/acertos.js": {
      "maxDuration": 30
    },
    "api/avisos.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/acertos?acao=conferir&turno=noite",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/acertos?acao=conferir&turno=manha",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/banco?acao=coletar&turno=madrugada",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/banco?acao=coletar&turno=manha",
      "schedule": "15 13 * * *"
    },
    {
      "path": "/api/banco?acao=coletar&turno=cedo",
      "schedule": "15 8 * * *"
    },
    {
      "path": "/api/banco?acao=coletar&turno=tarde",
      "schedule": "15 19 * * *"
    },
    {
      "path": "/api/banco?acao=coletar&turno=noite",
      "schedule": "15 23 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}